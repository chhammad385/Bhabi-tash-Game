# ---------------------------------------------------------------------------
# Bhabhi Multiplayer — environment template
#
# Copy to .env for local development:   cp .env.example .env
# NEVER commit a real .env file. Placeholders only in this file.
# ---------------------------------------------------------------------------

# --- BACKEND (Render web service) ------------------------------------------

# Neon PostgreSQL connection string. REQUIRED in production.
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Session signing secret. REQUIRED — the server refuses to start without it.
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long issued session tokens stay valid (optional, default 7d).
JWT_EXPIRES_IN=7d

# Allowed browser origin(s) for CORS. REQUIRED in production.
# Single origin, or comma-separated list. Never use "*".
# Example: https://your-app.vercel.app
CLIENT_URL=

# Runtime environment and port. Render sets PORT automatically.
NODE_ENV=development
PORT=3000


# --- FRONTEND (Vercel build-time, baked into the bundle) --------------------
# These are PUBLIC values. Never put secrets in a VITE_* variable.

# Base URL of the backend REST API, e.g. https://bhabhi-api.onrender.com
# Leave blank for a unified single-server deployment (same origin).
VITE_API_URL=

# Base URL for the Socket.IO connection. Usually identical to VITE_API_URL.
VITE_WS_URL=
